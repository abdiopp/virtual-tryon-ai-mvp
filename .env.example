HF_TOKEN=

# Lightweight cloth generation model (fast few-step inference)
CLOTH_MODEL_ID=stabilityai/sd-turbo
CLOTH_LORA_PATH=
CLOTH_LOCAL_FILES_ONLY=true

# Try-on backend (CPU/iGPU friendly fallback)
TRYON_BACKEND=fashn_vton
FASHN_REPO_URL=https://github.com/fashn-AI/fashn-vton-1.5.git
FASHN_MODEL_DIR=models/fashn_vton
FASHN_WEIGHTS_DIR=models/fashn_weights
FASHN_NUM_TIMESTEPS=8
FASHN_GUIDANCE_SCALE=1.2
FASHN_NUM_SAMPLES=1
FASHN_SEGMENTATION_FREE=true
FASHN_GARMENT_PHOTO_TYPE=flat-lay

MODEL_CACHE_DIR=models/huggingface
OUTPUT_DIR=outputs
UPLOAD_DIR=uploads

# Use cpu on Intel integrated graphics, mps on Apple Silicon, cuda on NVIDIA
DEVICE=cpu
MPS_USE_FP16=false

DEFAULT_IMAGE_WIDTH=512
DEFAULT_IMAGE_HEIGHT=768

# Auto-limit heavy requests on non-CUDA devices for better responsiveness
NON_CUDA_FORCE_FAST_LIMITS=true
NON_CUDA_MAX_COUNT=2
NON_CUDA_MAX_STEPS=6
NON_CUDA_MAX_PIXELS=393216

PROMPT_ENHANCEMENT_ENABLED=true
PROMPT_ENHANCEMENT_TEMPLATE=front view ecommerce product photo of a {prompt}, isolated garment, clean white background, realistic cotton fabric texture, symmetrical design, high detail, no person, no mannequin
