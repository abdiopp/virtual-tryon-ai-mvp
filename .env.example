HF_TOKEN=

# Flux cloth generation model
CLOTH_MODEL_ID=black-forest-labs/FLUX.1-schnell
CLOTH_INFERENCE_PROVIDER=nscale
CLOTH_MAX_GENERATION_ATTEMPTS=3
CLOTH_MIN_BORDER_MARGIN_RATIO=0.08

# Try-on backend. Default runs IDM-VTON on Hugging Face, not this machine.
TRYON_BACKEND=huggingface_space
TRYON_SPACE_ID=yisol/IDM-VTON
TRYON_SPACE_API_NAME=/tryon
TRYON_SPACE_DENOISE_STEPS=30
TRYON_SPACE_SEED=42
TRYON_SPACE_AUTO_MASK=true
TRYON_SPACE_AUTO_CROP=false

# Local Leffa backend settings; use TRYON_BACKEND=leffa to enable.
LEFFA_REPO_URL=https://github.com/franciszzj/Leffa.git
LEFFA_MODEL_DIR=models/leffa
LEFFA_CHECKPOINT_DIR=models/leffa_ckpts
LEFFA_HF_REPO_ID=franciszzj/Leffa
LEFFA_NUM_INFERENCE_STEPS=30
LEFFA_GUIDANCE_SCALE=2.5
LEFFA_SEED=42
LEFFA_MODEL_TYPE=auto
LEFFA_REF_ACCELERATION=false
LEFFA_REPAINT=false
LEFFA_PREPROCESS_GARMENT=false
LEFFA_REQUIRE_CUDA=true
LEFFA_MEMORY_EFFICIENT_LOAD=true

# Legacy FASHN backend settings; use TRYON_BACKEND=fashn_vton to enable.
FASHN_REPO_URL=https://github.com/fashn-AI/fashn-vton-1.5.git
FASHN_MODEL_DIR=models/fashn_vton
FASHN_WEIGHTS_DIR=models/fashn_weights
FASHN_NUM_TIMESTEPS=30
FASHN_GUIDANCE_SCALE=1.5
FASHN_NUM_SAMPLES=1
FASHN_SEGMENTATION_FREE=true
FASHN_GARMENT_PHOTO_TYPE=flat-lay

OUTPUT_DIR=outputs
UPLOAD_DIR=uploads

# Device is only used by optional local backends.
DEVICE=auto
MPS_USE_FP16=false

DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024

PROMPT_ENHANCEMENT_ENABLED=true
PROMPT_ENHANCEMENT_TEMPLATE=clean ecommerce catalog image of one complete {prompt}, {category}, entire garment fully visible from top to bottom with both sleeves, cuffs, hem, collar, hood, and all edges fully inside the frame, centered with generous white margin on every side, zoomed-out product photo, sleeves hanging naturally downward close to the body, plain white background, realistic fabric texture, balanced lighting, no person, no mannequin, no hanger, no body parts, not cropped, no close-up, no edge touching the image border
