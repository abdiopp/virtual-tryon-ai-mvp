HF_TOKEN=

# Colab-quality cloth generation model
CLOTH_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
CLOTH_LORA_PATH=
CLOTH_LOCAL_FILES_ONLY=true
CLOTH_ENABLE_MODEL_CPU_OFFLOAD=false
CLOTH_UNLOAD_AFTER_REQUEST=true

# Try-on backend
TRYON_BACKEND=leffa
LEFFA_REPO_URL=https://github.com/franciszzj/Leffa.git
LEFFA_MODEL_DIR=models/leffa
LEFFA_CHECKPOINT_DIR=models/leffa_ckpts
LEFFA_HF_REPO_ID=franciszzj/Leffa
LEFFA_NUM_INFERENCE_STEPS=30
LEFFA_GUIDANCE_SCALE=2.5
LEFFA_SEED=42
LEFFA_MODEL_TYPE=auto
LEFFA_REF_ACCELERATION=false
LEFFA_REPAINT=false
LEFFA_PREPROCESS_GARMENT=false

# Legacy FASHN backend settings; use TRYON_BACKEND=fashn_vton to enable.
FASHN_REPO_URL=https://github.com/fashn-AI/fashn-vton-1.5.git
FASHN_MODEL_DIR=models/fashn_vton
FASHN_WEIGHTS_DIR=models/fashn_weights
FASHN_NUM_TIMESTEPS=30
FASHN_GUIDANCE_SCALE=1.5
FASHN_NUM_SAMPLES=1
FASHN_SEGMENTATION_FREE=true
FASHN_GARMENT_PHOTO_TYPE=flat-lay

MODEL_CACHE_DIR=models/huggingface
OUTPUT_DIR=outputs
UPLOAD_DIR=uploads

# Use auto for CUDA on Colab, then MPS, then CPU
DEVICE=auto
MPS_USE_FP16=false

DEFAULT_IMAGE_WIDTH=768
DEFAULT_IMAGE_HEIGHT=1024

# Auto-limit heavy requests on non-CUDA devices for better responsiveness
NON_CUDA_FORCE_FAST_LIMITS=true
NON_CUDA_MAX_COUNT=2
NON_CUDA_MAX_STEPS=6
NON_CUDA_MAX_PIXELS=393216

PROMPT_ENHANCEMENT_ENABLED=true
PROMPT_ENHANCEMENT_TEMPLATE=front view high-end ecommerce product photo of a {prompt}, isolated {category}, clean white background, realistic fabric texture, natural seams and stitching, symmetrical silhouette, high detail, no person, no mannequin
